# ---- 平台元数据库（PostgreSQL 16，compose 里的 platform-pg）
# DATABASE_URL=postgresql+psycopg://insight:insight@localhost:5432/insight

# ---- 被分析的业务数据源（必须只读账号）
# DATASOURCE_DIALECT=starrocks       # starrocks | mysql | postgresql，同时用作 SQL 方言
# DATASOURCE_URL=                    # 仅非 starrocks 数据源需要；填 starrocks 时由下面 STARROCKS_* 组装

# ---- 私有化 LLM
# LLM_BASE_URL=http://your-llm-gateway/v1
# LLM_MODEL=qwen2.5-coder-32b
# LLM_API_KEY=EMPTY
# SELF_CORRECT_RETRIES=2
# LLM_MAX_TOKENS=8192              # 单次生成上限
# LLM_ENABLE_THINKING=false        # 复杂多表题临时设 true

# ---- 向量索引（LanceDB）
# LANCE_DIR=./data/lance
# EMBEDDING_PROVIDER=bge-m3        # 目前只支持 bge-m3(1024d)
# EMBEDDING_MODEL_DIR=             # bge-m3 权重目录，留空则用 HF 缓存/联网；内网建议本地目录
# 换 provider 后必须重建索引：python scripts/reindex_vectors.py --drop

# ---- 熔断
# QUERY_ROW_LIMIT=1000
# QUERY_TIMEOUT=10

# ---- 登录 / JWT
# TOKEN_SECRET=                    # HS256 签名密钥，留空则每次启动随机（重启即全员重新登录）
# TOKEN_TTL_MINUTES=480            # 令牌有效期，默认 8 小时
# LOGIN_MAX_FAILS=5                # 连错几次锁账号
# LOGIN_LOCK_MINUTES=15            # 锁定时长
# LOGIN_RATE_PER_MINUTE=5          # 单 IP 每分钟登录尝试上限
# REDIS_URL=                       # 留空=吊销表与限流放进程内存（单进程够用）；多 worker/多副本必须指 Redis
                                   # 容器内填 redis://redis:6379/0，宿主机直连填 redis://localhost:6379/0
# ADMIN_INIT_PASSWORD=             # 首次播种 admin 用的口令，留空则随机并打印一次
